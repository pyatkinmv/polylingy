              "past simple",
              "past participle"
            ],
            "rows": [
              [
                "be",
                "was / were",
                "been"
              ]
            ]
          },
          {
            "type": "text",
            "text": "Past simple: *I **was** at home yesterday.*  ·  present perfect: *Have you ever **been** to Rome?*"
          }
        ]
      },
      "exercises": [
