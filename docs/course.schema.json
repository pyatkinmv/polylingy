{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polylingy.app/schema/course-5.json",
  "title": "Polylingy course, format 5",
  "description": "The shape of course.json. The app checks more than this schema can say (markup, blanks per item, links pointing at real sections, model answers passing their keys): run ./gradlew :app:checkCourse. See docs/content-format.md.",
  "$ref": "#/$defs/course",
  "$defs": {
    "uuid": {
      "description": "A UUID. Ids may be left out in a file: the app adds them on import.",
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "instant": {
      "description": "A moment in UTC, ISO 8601: 2026-11-01T10:00:00Z.",
      "type": "string",
      "format": "date-time"
    },
    "inline": {
      "description": "Text with markup: **bold**, *italic*, line breaks \\n, annotated words [word](annotation) shown with the annotation over them; in exercises blanks {{answer|other variant}}. \\\\ makes the next * { } | [ ] \\\\ literal. See content-format.md, section 3.",
      "type": "string",
      "minLength": 1
    },
    "audio": {
      "description": "A sound: an https:// URL or a path inside the course archive (audio/hello.mp3); .mp3 or .wav. It plays when its button is pressed.",
      "type": "string",
      "pattern": "[.](mp3|wav|MP3|WAV)$"
    },
    "image": {
      "description": "A picture: an https:// URL or a path inside the course archive (images/cat.png). alt describes it.",
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "src",
        "alt"
      ],
      "additionalProperties": false
    },
    "course": {
      "description": "A course file (course.json). It has either units or topics, not both.",
      "type": "object",
      "properties": {
        "formatVersion": {
          "description": "The format this file is written in. This schema describes 5.",
          "const": 5
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "description": {
          "$ref": "#/$defs/inline"
        },
        "createdAt": {
          "$ref": "#/$defs/instant"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "$ref": "#/$defs/instant"
        },
        "theme": {
          "$ref": "#/$defs/theme"
        },
        "rules": {
          "$ref": "#/$defs/rules"
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          }
        }
      },
      "required": [
        "formatVersion",
        "name"
      ],
      "additionalProperties": false
    },
    "theme": {
      "description": "The course's look.",
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "additionalProperties": false
    },
    "unit": {
      "description": "A part of a course: a page of theory and the topics that practise it.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subtitle": {
          "$ref": "#/$defs/inline"
        },
        "theory": {
          "$ref": "#/$defs/content"
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topic"
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "topics"
      ],
      "additionalProperties": false
    },
    "topic": {
      "description": "The unit of spaced repetition; each time it is shown, one of its exercises is picked.",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "explanation": {
          "$ref": "#/$defs/content"
        },
        "exercises": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exercise"
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "exercises"
      ],
      "additionalProperties": false
    },
    "rules": {
      "description": "Study settings the course starts with: a preset and the parts that differ from it. See learning-model.md.",
      "type": "object",
      "properties": {
        "preset": {
          "enum": [
            "quick",
            "ladder",
            "sm2"
          ]
        },
        "grading": {
          "oneOf": [
            {
              "$ref": "#/$defs/grading.all-correct"
            },
            {
              "$ref": "#/$defs/grading.threshold"
            }
          ]
        },
        "mastery": {
          "oneOf": [
            {
              "$ref": "#/$defs/mastery.consecutive"
            }
          ]
        },
        "scheduler": {
          "oneOf": [
            {
              "$ref": "#/$defs/scheduler.once"
            },
            {
              "$ref": "#/$defs/scheduler.ladder"
            },
            {
              "$ref": "#/$defs/scheduler.sm2"
            }
          ]
        },
        "picker": {
          "oneOf": [
            {
              "$ref": "#/$defs/picker.conveyor"
            },
            {
              "$ref": "#/$defs/picker.shuffle"
            },
            {
              "$ref": "#/$defs/picker.alternate"
            }
          ]
        },
        "display": {
          "$ref": "#/$defs/display"
        }
      },
      "additionalProperties": false
    },
    "display": {
      "description": "How exercises look: annotations over words shown (default true); avoid exercises that need typing when a topic has others (default false).",
      "type": "object",
      "properties": {
        "annotations": {
          "type": "boolean"
        },
        "avoidTyping": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "grading.all-correct": {
      "description": "Right when every item is right.",
      "type": "object",
      "properties": {
        "type": {
          "const": "all-correct"
        },
        "typos": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "grading.threshold": {
      "description": "Right when at least min of the items are right.",
      "type": "object",
      "properties": {
        "type": {
          "const": "threshold"
        },
        "min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "typos": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "min"
      ],
      "additionalProperties": false
    },
    "mastery.consecutive": {
      "description": "Learned after this many right answers in a row.",
      "type": "object",
      "properties": {
        "type": {
          "const": "consecutive"
        },
        "learning": {
          "type": "integer",
          "minimum": 1
        },
        "review": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "learning",
        "review"
      ],
      "additionalProperties": false
    },
    "scheduler.once": {
      "description": "Once learned, never shown again.",
      "type": "object",
      "properties": {
        "type": {
          "const": "once"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "scheduler.ladder": {
      "description": "Reviews after these days; without retire the last gap doubles.",
      "type": "object",
      "properties": {
        "type": {
          "const": "ladder"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "retire": {
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "scheduler.sm2": {
      "description": "SuperMemo-2.",
      "type": "object",
      "properties": {
        "type": {
          "const": "sm2"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "picker.conveyor": {
      "description": "Stays on a topic until its round is done.",
      "type": "object",
      "properties": {
        "type": {
          "const": "conveyor"
        },
        "newPerDay": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "picker.shuffle": {
      "description": "Topics in random order.",
      "type": "object",
      "properties": {
        "type": {
          "const": "shuffle"
        },
        "newPerDay": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "picker.alternate": {
      "description": "Moves on after every answer.",
      "type": "object",
      "properties": {
        "type": {
          "const": "alternate"
        },
        "newPerDay": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "content": {
      "description": "A page of content: unit theory or an explanation.",
      "type": "object",
      "properties": {
        "format": {
          "const": "blocks"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "required": [
        "format",
        "blocks"
      ],
      "additionalProperties": false
    },
    "block": {
      "description": "A building block of a content page, told apart by \"type\".",
      "oneOf": [
        {
          "$ref": "#/$defs/block.section"
        },
        {
          "$ref": "#/$defs/block.text"
        },
        {
          "$ref": "#/$defs/block.situation"
        },
        {
          "$ref": "#/$defs/block.image"
        },
        {
          "$ref": "#/$defs/block.table"
        },
        {
          "$ref": "#/$defs/block.dialogue"
        },
        {
          "$ref": "#/$defs/block.track"
        },
        {
          "$ref": "#/$defs/block.video"
        },
        {
          "$ref": "#/$defs/block.quote"
        },
        {
          "$ref": "#/$defs/block.examples"
        },
        {
          "$ref": "#/$defs/block.words"
        },
        {
          "$ref": "#/$defs/block.tip"
        },
        {
          "$ref": "#/$defs/block.seeAlso"
        }
      ]
    },
    "block.section": {
      "description": "A part of a page: with a label (a letter) it is lettered in the margin; without one its title is a heading. id is set only on sections a seeAlso link points at.",
      "type": "object",
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "$ref": "#/$defs/inline"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "blocks"
      ],
      "additionalProperties": false
    },
    "block.text": {
      "description": "A paragraph.",
      "type": "object",
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "block.situation": {
      "description": "A framed example situation, with an optional aside block (usually a picture).",
      "type": "object",
      "properties": {
        "type": {
          "const": "situation"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        },
        "aside": {
          "$ref": "#/$defs/block"
        }
      },
      "required": [
        "type",
        "blocks"
      ],
      "additionalProperties": false
    },
    "block.image": {
      "description": "A picture.",
      "type": "object",
      "properties": {
        "type": {
          "const": "image"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "caption": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "src",
        "alt"
      ],
      "additionalProperties": false
    },
    "cell": {
      "description": "A theory table cell: a text, or {text, rowSpan, audio}; a cell with audio shows a play button and may leave text out.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "description": "A cell spanning rows, or with a sound.",
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "rowSpan": {
              "type": "integer",
              "minimum": 1
            },
            "audio": {
              "$ref": "#/$defs/audio"
            }
          },
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "text"
              ]
            },
            {
              "required": [
                "audio"
              ]
            }
          ]
        }
      ]
    },
    "block.table": {
      "description": "A table; all rows have the same number of columns, counting cells spanned from above.",
      "type": "object",
      "properties": {
        "type": {
          "const": "table"
        },
        "head": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/cell"
            }
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "rows"
      ],
      "additionalProperties": false
    },
    "line": {
      "description": "One remark of a dialogue: who says it, what, its sound, and its translation (small and grey under it; the course decides where one helps).",
      "type": "object",
      "properties": {
        "who": {
          "$ref": "#/$defs/inline"
        },
        "text": {
          "$ref": "#/$defs/inline"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "translation": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "block.track": {
      "description": "A recording of its own, as a book prints it beside a section: one sound with a title. A long one plays in the player docked at the bottom of the window, where it can be paused and rewound.",
      "type": "object",
      "properties": {
        "type": {
          "const": "track"
        },
        "title": {
          "$ref": "#/$defs/inline"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        }
      },
      "required": [
        "type",
        "title",
        "audio"
      ],
      "additionalProperties": false
    },
    "block.video": {
      "description": "A video on the web, which the app opens in the browser: the course points to it, it does not carry it.",
      "type": "object",
      "properties": {
        "type": {
          "const": "video"
        },
        "title": {
          "$ref": "#/$defs/inline"
        },
        "url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "note": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "title",
        "url"
      ],
      "additionalProperties": false
    },
    "block.dialogue": {
      "description": "A conversation, one line per remark with the speaker's name on the left and an optional sound.",
      "type": "object",
      "properties": {
        "type": {
          "const": "dialogue"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "lines"
      ],
      "additionalProperties": false
    },
    "block.quote": {
      "description": "A line of speech in a bubble.",
      "type": "object",
      "properties": {
        "type": {
          "const": "quote"
        },
        "text": {
          "$ref": "#/$defs/inline"
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "aside": {
          "$ref": "#/$defs/block"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "example": {
      "description": "One example; not is the wrong form to contrast with; translation shows small and grey under it; audio gives it a play button.",
      "type": "object",
      "properties": {
        "text": {
          "$ref": "#/$defs/inline"
        },
        "not": {
          "$ref": "#/$defs/inline"
        },
        "translation": {
          "$ref": "#/$defs/inline"
        },
        "audio": {
          "$ref": "#/$defs/audio"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "block.examples": {
      "description": "A list of examples.",
      "type": "object",
      "properties": {
        "type": {
          "const": "examples"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "items"
      ],
      "additionalProperties": false
    },
    "block.words": {
      "description": "A row of words.",
      "type": "object",
      "properties": {
        "type": {
          "const": "words"
        },
        "words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "words"
      ],
      "additionalProperties": false
    },
    "block.tip": {
      "description": "A highlighted tip.",
      "type": "object",
      "properties": {
        "type": {
          "const": "tip"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "blocks"
      ],
      "additionalProperties": false
    },
    "link": {
      "description": "A link to a theory section (its id) or to the top of a unit's theory (its id).",
      "oneOf": [
        {
          "description": "To a section.",
          "type": "object",
          "properties": {
            "section": {
              "$ref": "#/$defs/uuid"
            }
          },
          "required": [
            "section"
          ],
          "additionalProperties": false
        },
        {
          "description": "To a unit.",
          "type": "object",
          "properties": {
            "unit": {
              "$ref": "#/$defs/uuid"
            }
          },
          "required": [
            "unit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "block.seeAlso": {
      "description": "Links to theory.",
      "type": "object",
      "properties": {
        "type": {
          "const": "seeAlso"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          },
          "minItems": 1
        }
      },
      "required": [
        "type",
        "links"
      ],
      "additionalProperties": false
    },
    "exercise": {
      "description": "An exercise, told apart by \"type\". Every type has the same layers: instruction, wordBank (some types), audio, look, aside, the body (the type's own fields), explanation. See content-format.md, section 5.",
      "oneOf": [
        {
          "$ref": "#/$defs/exercise.gaps"
        },
        {
          "$ref": "#/$defs/exercise.choice"
        },
        {
          "$ref": "#/$defs/exercise.pictures"
        },
        {
          "$ref": "#/$defs/exercise.table"
        },
        {
          "$ref": "#/$defs/exercise.match"
        },
        {
          "$ref": "#/$defs/exercise.order"
        },
        {
          "$ref": "#/$defs/exercise.expand"
        },
        {
          "$ref": "#/$defs/exercise.fix"
        }
      ]
    },
    "look": {
      "description": "Layer 3: a frame with a header around the body. Fits every exercise type.",
      "oneOf": [
        {
          "$ref": "#/$defs/look.email"
        },
        {
          "$ref": "#/$defs/look.article"
        },
        {
          "$ref": "#/$defs/look.newspaper"
        }
      ]
    },
    "look.email": {
      "description": "An email: subject on top, then the sender (with an initial) and the recipient.",
      "type": "object",
      "properties": {
        "type": {
          "const": "email"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subject": {
          "$ref": "#/$defs/inline"
        }
      },
      "required": [
        "type",
        "from",
        "subject"
      ],
      "additionalProperties": false
    },
    "look.article": {
      "description": "A page of a magazine, newspaper or blog: a small source line over the title.",
      "type": "object",
      "properties": {
        "type": {
          "const": "article"
        },
        "title": {
          "$ref": "#/$defs/inline"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false
    },
    "look.newspaper": {
      "description": "A newspaper clipping: the headline, big and bold in a dotted frame, with a small source line (the paper, the day) over it.",
      "type": "object",
      "properties": {
        "type": {
          "const": "newspaper"
        },
        "headline": {
          "$ref": "#/$defs/inline"
        },
        "source": {
          "type": "string",
